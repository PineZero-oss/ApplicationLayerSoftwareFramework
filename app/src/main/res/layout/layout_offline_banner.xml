<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offline_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#DCD8CC"
    android:orientation="vertical"
    android:padding="14dp"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Working offline"
        android:textColor="#5E3023"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/offline_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Last synchronized: --&#10;Pending changes: 0"
        android:textColor="#85857D"
        android:textSize="12sp" />

</LinearLayout>